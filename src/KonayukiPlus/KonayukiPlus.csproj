<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>KonayukiPlus</AssemblyName>
    <GenerateAssemblyInfo>False</GenerateAssemblyInfo>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>True</UseWindowsForms>
    <TargetFramework>net471</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <Deterministic>True</Deterministic>
    <!-- Costura unpacks the embedded dependencies at runtime, so nothing is copied next to the exe. -->
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
  <PropertyGroup>
    <LangVersion>11.0</LangVersion>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <CheckForOverflowUnderflow>False</CheckForOverflowUnderflow>
  </PropertyGroup>
  <PropertyGroup>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RootNamespace />
    <!-- The .resx ILSpy produced hold BinaryFormatter-serialized images that the modern SDK refuses to
         re-serialize. We embed the already-compiled .resources from the original assembly verbatim instead,
         which the .NET Framework runtime reads natively. So turn off the default .resx/.resources globbing. -->
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
  </PropertyGroup>
  <ItemGroup>
    <!-- Original compiled WinForms/Resources streams, embedded under their exact manifest names. -->
    <EmbeddedResource Include="res\*.resources">
      <LogicalName>%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <!-- Costura.Fody payload: compressed dependency assemblies, unpacked by the module initializer at startup. -->
    <EmbeddedResource Include="costura.*.compressed">
      <LogicalName>%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <Reference Include="MetroFramework">
      <HintPath>..\..\build\refs\MetroFramework.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="NAudio">
      <HintPath>..\..\build\refs\NAudio.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>..\..\build\refs\Newtonsoft.Json.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="ByteSize">
      <HintPath>..\..\build\refs\ByteSize.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="DotNetZip">
      <HintPath>..\..\build\refs\DotNetZip.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Microsoft.WindowsAPICodePack.Shell">
      <HintPath>..\..\build\refs\Microsoft.WindowsAPICodePack.Shell.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Microsoft.WindowsAPICodePack">
      <HintPath>..\..\build\refs\Microsoft.WindowsAPICodePack.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="System.Core" />
    <Reference Include="Microsoft.VisualBasic" />
    <Reference Include="System.Management" />
    <Reference Include="Microsoft.CSharp" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net471" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
</Project>
